[global]
ca_file = "include/auth-ca.crt"
certificate_file = "include/vs-noise.crt"
private_key_file = "include/vs-noise.key"
zpr_addr = [ "fd5a:5052::1" ] # visa service well known addr
tun_if = "tun9"

[adapter]
name = "vs.zpr"
# Node0 owns the bootstrap VS adapter; node1 reaches VS across the node peer.
node_addr = "@@NODE0_ADDR@@:5000"
node_public_key_file = "include/node0-noise-pub.pem"
bootstrap_key = "include/vs-private-key.pem"

